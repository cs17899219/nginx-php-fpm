server {
    listen 8080;
    listen [::]:8080 default ipv6only=on;
    server_name _;
    root @WEBROOT@;
    index index.php index.html index.htm;
    sendfile off;
    error_log /dev/stderr warn;
    access_log /dev/stdout;

    #real_ip_header X-Forwarded-For;
    #set_real_ip_from 172.16.0.0/12;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }
    location = /index.php {
        try_files /index.php =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/nginx/php-fpm.sock;
    }
    # Before all static regex locations: deny execution AND source downloads.
    location ~* \.(?:php[0-9]*|phtml|phar)(?:/|$) {
        return 404;
    }
    location ~ /\. {
        log_not_found off;
        deny all;
    }
    location ~* \.(jpg|jpeg|gif|png|css|js|ico|webp|tiff|ttf|svg)$ {
        expires 5d;
    }
    error_page 404 /404.html;
    location = /404.html {
        root /var/www/errors;
        internal;
    }
    location = /sad.svg { alias /var/www/errors/sad.svg; access_log off; }
    location = /twitter.svg { alias /var/www/errors/twitter.svg; access_log off; }
    location = /github.svg { alias /var/www/errors/github.svg; access_log off; }
}
